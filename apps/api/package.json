{
  "name": "@whoaped/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env watch src/index.ts",
    "dev:stream": "tsx --env-file-if-exists=.env watch src/stream.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "start:stream": "node --env-file-if-exists=.env dist/stream.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "setup:telegram": "node --env-file-if-exists=.env dist/telegram-setup.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@solana-program/memo": "^0.16.0",
    "@solana-program/token": "^0.18.0",
    "@solana/kit": "^8.6.0",
    "firebase-admin": "^14.3.0",
    "hono": "^4.13.5",
    "mongodb": "^7.7.0",
    "ws": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/ws": "^8.18.2",
    "mongodb-memory-server": "^11.3.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
