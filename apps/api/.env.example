JUPITER_API_KEY=
INTERNAL_JOB_SECRET=replace-with-a-different-long-random-secret
CORS_ORIGIN=*
FIREBASE_PROJECT_ID=
# Preferred outside Google Cloud: base64-encode the complete Firebase Admin
# service-account JSON. Raw JSON remains supported for local compatibility.
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_SERVICE_ACCOUNT_JSON=
# Optional per-DEX trade URLs and referral codes. Prefer Base64 on DigitalOcean.
DEX_LINK_CONFIG_BASE64=
DEX_LINK_CONFIG_JSON=
TOKEN_ACTION_CONFIG_BASE64=
TOKEN_ACTION_CONFIG_JSON=
TELEGRAM_BOT_TOKEN=
DISCOVERY_REPORT_TELEGRAM_USERNAME=heymike777
# Optional: pin admin report access and delivery to your numeric Telegram user/chat ID.
DISCOVERY_REPORT_TELEGRAM_USER_ID=
STREAMFLOW_CLUSTER=devnet
STREAMFLOW_RPC_URL=https://api.devnet.solana.com
STREAMFLOW_POOL_ADDRESS=
STREAMFLOW_TOKEN_MINT=
STREAMFLOW_TOKEN_SYMBOL=
STREAMFLOW_REQUIRED_AMOUNT_RAW=

