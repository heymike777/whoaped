PORT=8787
MONGODB_URI=mongodb://localhost:27017/whoaped
MONGODB_DATABASE=whoaped
HELIUS_API_KEY=
HELIUS_PARSED_STREAM_URL=wss://fs-beta.helius-rpc.com
HELIUS_WALLET_REFRESH_MS=5000
HELIUS_STREAM_PING_MS=240000
HELIUS_BACKFILL_CONCURRENCY=4
HELIUS_BACKFILL_MAX_PAGES=20
# Optional but recommended in production. Keyless Jupiter Tokens requests are rate-limited.
JUPITER_API_KEY=
INTERNAL_JOB_SECRET=replace-with-a-different-long-random-secret
CORS_ORIGIN=*
FIREBASE_PROJECT_ID=
# Preferred outside Google Cloud: base64-encode the complete Firebase Admin
# service-account JSON. Raw JSON remains supported for local compatibility.
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_SERVICE_ACCOUNT_JSON=
# Optional per-DEX trade URLs and referral codes. Prefer Base64 on DigitalOcean.
DEX_LINK_CONFIG_BASE64=
DEX_LINK_CONFIG_JSON=
TOKEN_ACTION_CONFIG_BASE64=
TOKEN_ACTION_CONFIG_JSON=
TELEGRAM_BOT_TOKEN=